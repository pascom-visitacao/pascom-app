# Preenche com os valores do Google Cloud Console (projeto "PASCOM Drive"):
# - GOOGLE_DRIVE_CLIENT_ID / GOOGLE_DRIVE_CLIENT_SECRET: Clientes > PASCOM Drive Setup
# - GOOGLE_PICKER_API_KEY: Credenciais > Chaves de API > PASCOM Picker
#
# Copia esse arquivo pra ".env.drive-setup" (sem ".example") e preenche ali -
# esse arquivo cai automaticamente no .gitignore (padrão .env* já existente).

GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_PICKER_API_KEY=

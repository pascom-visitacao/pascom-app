# Painel do projeto Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Habilitar o provider Google em Authentication > Providers, usando as
# credenciais OAuth do Google Cloud (conta Workspace da paróquia).
# A URL de redirect autorizada no Google Cloud deve ser a de callback
# do próprio Supabase, algo como:
# https://xxxxxxxxxxxx.supabase.co/auth/v1/callback

# --- Notificações por e-mail (Fase 5) — usadas só nas rotas /api/cron/* ---

# Painel do projeto Supabase > Project Settings > API > service_role
# NUNCA expor no client, só em rotas server-only. Ignora RLS por completo.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# resend.com > API Keys. Enquanto o domínio de envio não for verificado
# no Resend, o modo é "sandbox": e-mails só chegam na caixa do dono da
# conta Resend, não na equipe real. Ver README para detalhes.
RESEND_API_KEY=your-resend-api-key

# Secret compartilhado que autentica as chamadas às rotas /api/cron/*.
# Precisa estar configurado em DOIS lugares com o MESMO valor:
#   1. Vercel: Project Settings > Environment Variables > CRON_SECRET
#   2. GitHub: Settings > Secrets and variables > Actions > CRON_SECRET
# Gerar um novo valor com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=your-cron-secret

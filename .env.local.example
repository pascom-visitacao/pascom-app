# Painel do projeto Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Habilitar o provider Google em Authentication > Providers, usando as
# credenciais OAuth do Google Cloud (conta Workspace da paróquia).
# A URL de redirect autorizada no Google Cloud deve ser a de callback
# do próprio Supabase, algo como:
# https://xxxxxxxxxxxx.supabase.co/auth/v1/callback

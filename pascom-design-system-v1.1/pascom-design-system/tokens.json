{
  "$schema": "Pascom Design System — Design Tokens",
  "meta": {
    "name": "Pascom Design System",
    "source": "Identidade visual oficial — Paróquia N. Sra. da Visitação",
    "version": "1.0.0"
  },
  "color": {
    "green":   { "50": "#f6fbf4", "100": "#eaf6e6", "200": "#d2ecc9", "300": "#b4dfa5", "400": "#8fcf78", "500": "#6abf4b", "600": "#5ca041", "700": "#4d8236", "800": "#3f632c", "900": "#324823" },
    "blue":    { "50": "#f0f7fb", "100": "#dbedf5", "200": "#b2d8ea", "300": "#80bedc", "400": "#409dcb", "500": "#007cba", "600": "#05699c", "700": "#09577e", "800": "#0e445f", "900": "#123444" },
    "amber":   { "50": "#fffbf1", "100": "#fff5de", "200": "#fee9b9", "300": "#feda8a", "400": "#fec850", "500": "#fdb615", "600": "#d49914", "700": "#ab7c14", "800": "#825f13", "900": "#5e4513" },
    "red":     { "50": "#fdf4f3", "100": "#fbe6e4", "200": "#f6c9c5", "300": "#f0a59e", "400": "#e8786e", "500": "#e14b3d", "600": "#bd4135", "700": "#99382e", "800": "#762e26", "900": "#56251f" },
    "neutral": { "0": "#ffffff", "50": "#faf9f9", "100": "#f2f2f2", "200": "#e0e0e0", "300": "#c1c0c1", "400": "#9c9a9b", "500": "#777475", "600": "#535051", "700": "#393536", "800": "#2c2829", "900": "#231f20", "950": "#151313" }
  },
  "semantic": {
    "primary":         "color.blue.500",
    "primaryHover":    "color.blue.600",
    "primaryActive":   "color.blue.700",
    "primarySubtle":   "color.blue.50",
    "secondary":       "color.green.500",
    "secondaryHover":  "color.green.600",
    "secondaryActive": "color.green.700",
    "secondarySubtle": "color.green.50",
    "accent":          "color.amber.500",
    "accentHover":     "color.amber.600",
    "accentSubtle":    "color.amber.50",
    "success":         "color.green.500",
    "successSubtle":   "color.green.50",
    "successText":     "color.green.800",
    "warning":         "color.amber.500",
    "warningSubtle":   "color.amber.50",
    "warningText":     "color.amber.900",
    "danger":          "color.red.500",
    "dangerHover":     "color.red.600",
    "dangerSubtle":    "color.red.50",
    "dangerText":      "color.red.800",
    "info":            "color.blue.500",
    "infoSubtle":      "color.blue.50",
    "infoText":        "color.blue.800",
    "bg":              "color.neutral.0",
    "bgSubtle":        "color.neutral.50",
    "bgInset":         "color.neutral.100",
    "border":          "color.neutral.200",
    "borderStrong":    "color.neutral.300",
    "text":            "color.neutral.900",
    "textMuted":       "color.neutral.600",
    "textSubtle":      "color.neutral.500",
    "textInverse":     "color.neutral.0",
    "darkBg":          "color.neutral.900",
    "darkBgAlt":       "color.neutral.950",
    "darkBorder":      "color.neutral.700",
    "darkTextMuted":   "color.neutral.400"
  },
  "typography": {
    "fontFamily": {
      "display": "'Bricolage Grotesque', ui-rounded, 'Segoe UI', sans-serif",
      "body":    "'Hanken Grotesk', -apple-system, 'Segoe UI', sans-serif",
      "mono":    "'JetBrains Mono', ui-monospace, 'SF Mono', monospace"
    },
    "fontSize": {
      "xs": "0.75rem", "sm": "0.875rem", "base": "1rem", "md": "1.125rem",
      "lg": "1.25rem", "xl": "1.5rem", "2xl": "2rem", "3xl": "2.5rem",
      "4xl": "3rem", "5xl": "4rem"
    },
    "fontSizePx": {
      "xs": 12, "sm": 14, "base": 16, "md": 18, "lg": 20, "xl": 24,
      "2xl": 32, "3xl": 40, "4xl": 48, "5xl": 64
    },
    "fontWeight": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700 },
    "lineHeight": { "tight": 1.1, "snug": 1.3, "normal": 1.5, "loose": 1.7 }
  },
  "spacing": {
    "space-1": "2px", "space-2": "4px", "space-3": "8px", "space-4": "12px",
    "space-5": "16px", "space-6": "20px", "space-7": "24px", "space-8": "32px",
    "space-9": "40px", "space-10": "48px", "space-11": "64px", "space-12": "80px",
    "space-13": "96px"
  },
  "radius": {
    "none": "0px", "xs": "2px", "sm": "4px", "md": "8px", "lg": "12px",
    "xl": "16px", "2xl": "20px", "full": "9999px"
  },
  "shadow": {
    "sm": "0 1px 2px rgba(35,31,32,0.06), 0 1px 1px rgba(35,31,32,0.04)",
    "md": "0 4px 10px rgba(35,31,32,0.08), 0 2px 4px rgba(35,31,32,0.04)",
    "lg": "0 12px 24px rgba(35,31,32,0.10), 0 4px 8px rgba(35,31,32,0.05)",
    "xl": "0 24px 48px rgba(35,31,32,0.14), 0 8px 16px rgba(35,31,32,0.06)",
    "focus": "0 0 0 4px rgba(0,124,186,0.25)"
  },
  "motion": {
    "easeOut": "cubic-bezier(0.16, 1, 0.3, 1)",
    "durationFast": "120ms",
    "durationBase": "200ms",
    "durationSlow": "320ms"
  },
  "logo": {
    "variants": {
      "horizontal": "assets/pascom-horizontal.svg",
      "vertical": "assets/pascom-vertical.svg",
      "icon": "assets/pascom-icon.svg"
    },
    "minSize": {
      "horizontalDigitalPx": 120,
      "horizontalPrintMm": 30,
      "iconDigitalPx": 24,
      "iconPrintMm": 10
    }
  }
}
